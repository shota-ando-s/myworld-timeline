---
import '../styles/tokens.css';
import '../styles/app.css';
import '../styles/icons.css';
import DetailPanel from '../components/DetailPanel.astro';
import FilterBar from '../components/FilterBar.astro';
import Lane, { type LaneView } from '../components/Lane.astro';
import TimeAxis from '../components/TimeAxis.astro';
import { loadOrThrow, loadPodcastsOrThrow } from '../lib/load-glob.ts';
import { toPodcastIndex } from '../lib/podcast.ts';
import { LEADER_STYLE, laneBands, packEvents, packPeriods } from '../lib/layout.ts';
import { LANES, itemSpan } from '../lib/model.ts';
import { timelineWidth, yearToX } from '../lib/scale.ts';

/** 初期表示のズーム。クライアント側で変更されると JS が座標を計算し直す */
const ZOOM = 1;

const data = loadOrThrow();
const podcasts = toPodcastIndex(loadPodcastsOrThrow(new Set(data.items.map((i) => i.id))));
/** 聴ける回がある項目。帯と点に印を付けるためだけの集合 */
const listen = new Set(Object.keys(podcasts.byItem));
const width = timelineWidth(ZOOM);
const groupOrder = [...new Set(LANES.map((l) => l.group))];

const laneViews: LaneView[] = LANES.map((lane) => {
  const { periods, leaders, events } = data.byLane.get(lane.id)!;
  const packedBars = packPeriods(periods, ZOOM);
  const packedLeaders = packPeriods(leaders, ZOOM, LEADER_STYLE);
  const packedDots = packEvents(events, ZOOM);
  const bands = laneBands(packedBars.rowCount, packedLeaders.rowCount, packedDots.rowCount);

  /** 帯（王朝・人物）は同じ形で描く */
  const toBars = (list: typeof periods, packed: typeof packedBars) =>
    list.map((item, i) => ({
      item,
      row: packed.rows[i]!,
      x: yearToX(itemSpan(item)[0], ZOOM),
      w: packed.widths[i]!,
      label: packed.labels[i]!,
      listen: listen.has(item.id),
    }));

  return {
    lane,
    stripe: groupOrder.indexOf(lane.group) % 2,
    height: bands.height,
    ldTop: bands.leaderTop,
    evTop: bands.eventTop,
    bars: toBars(periods, packedBars),
    leaders: toBars(leaders, packedLeaders),
    dots: events.map((item, i) => ({
      item,
      row: packedDots.rows[i]!,
      x: yearToX(item.year, ZOOM),
      listen: listen.has(item.id),
    })),
  };
});

const payload = JSON.stringify(data.items).replace(/</g, '\\u003c');
const podcastPayload = JSON.stringify(podcasts).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>世界史タイムライン</title>
    <meta
      name="description"
      content="紀元前3500年から現代まで、世界の各地域で何が並行して起きていたかを見比べる年表。"
    />
    <link rel="icon" href={new URL('favicon.svg', Astro.url.origin + import.meta.env.BASE_URL + '/').pathname} />
  </head>

  <body>
    <header class="topbar">
      <h1 class="topbar__title">
        世界史タイムライン
        <small>
          紀元前3500年 — {new Date().getFullYear()}年 / 全{data.items.length}項目（うち人物{data.leaders.length}人）
        </small>
      </h1>
      <FilterBar />
    </header>

    <main class="app">
      <div class="tl-wrap">
        <div class="tl" id="tl">
          <div class="tl__inner" style={`--w:${width}px; --scan-x:0px`} id="tl-inner">
            <TimeAxis zoom={ZOOM} />
            <div class="lanes" id="lanes">
              {laneViews.map((view) => <Lane view={view} />)}
            </div>
            <div class="scan" id="scan" hidden></div>
          </div>
        </div>
        <div class="center-line" aria-hidden="true"></div>
      </div>
      <div class="mlist" id="mlist"></div>
      <DetailPanel />
    </main>

    <script type="application/json" id="tl-data" is:inline set:html={payload} />
    <script type="application/json" id="tl-podcast" is:inline set:html={podcastPayload} />
    <script>
      import '../scripts/timeline.ts';
    </script>
  </body>
</html>
