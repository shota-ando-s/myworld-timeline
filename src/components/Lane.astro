---
import type { LabelFit } from '../lib/layout.ts';
import { categoryById, formatItemDate, type Period, type TimelineEvent } from '../lib/model.ts';

/** 帯1本（王朝でも人物でも中身は同じ） */
export type BarView = { item: Period; row: number; x: number; w: number; label: LabelFit; listen: boolean };

export interface LaneView {
  lane: { id: string; label: string; note: string; group: string };
  stripe: number;
  height: number;
  ldTop: number;
  evTop: number;
  bars: BarView[];
  leaders: BarView[];
  dots: { item: TimelineEvent; row: number; x: number; listen: boolean }[];
}

interface Props {
  view: LaneView;
}
const { view } = Astro.props;
const { lane } = view;

const allBars: { bar: BarView; leader: boolean }[] = [
  ...view.bars.map((bar) => ({ bar, leader: false })),
  ...view.leaders.map((bar) => ({ bar, leader: true })),
];
---

<section class="lane" data-lane={lane.id} data-group={lane.group} data-stripe={view.stripe}>
  <div class="lane__label">
    <b>{lane.label}</b>
    <small>{lane.note}</small>
  </div>
  <div
    class="lane__track"
    style={`--h:${view.height}px; --ld-top:${view.ldTop}px; --ev-top:${view.evTop}px`}
  >
    {
      allBars.map(({ bar: { item, row, x, w, label, listen }, leader }) => (
        <button
          type="button"
          class:list={['bar', { 'bar--leader': leader }]}
          data-id={item.id}
          data-kind="period"
          data-leader={leader ? '' : undefined}
          data-listen={listen ? '' : undefined}
          data-label={label}
          data-cat={item.category}
          data-fam={categoryById.get(item.category)!.family}
          data-start={item.start}
          data-end={item.end ?? ''}
          data-start-circa={item.startCirca ? '' : undefined}
          data-end-circa={item.endCirca ? '' : undefined}
          data-ongoing={item.ongoing ? '' : undefined}
          style={`--bx:${x}px; --bw:${w}px; --row:${row}`}
          title={`${item.title}（${formatItemDate(item)}）`}
        >
          <span class="bar__label">{item.title}</span>
        </button>
      ))
    }
    {
      view.dots.map(({ item, row, x, listen }) => (
        <button
          type="button"
          class="ev"
          data-id={item.id}
          data-kind="event"
          data-cat={item.category}
          data-fam={categoryById.get(item.category)!.family}
          data-year={item.year}
          data-circa={item.circa ? '' : undefined}
          data-listen={listen ? '' : undefined}
          style={`--ex:${x}px; --row:${row}`}
          title={`${formatItemDate(item)} ${item.title}`}
        >
          <span class="ev__dot" data-shape={categoryById.get(item.category)!.shape} />
          <span class="ev__label">{item.title}</span>
        </button>
      ))
    }
  </div>
</section>
